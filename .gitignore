# ── Archivos sensibles / credenciales ───────────────────────
.env
# .env.example SÍ se sube (es la plantilla sin valores reales)

# ── Documentación interna (no va al repo) ───────────────────
docs/
CLAUDE.md

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
.installed.cfg
lib/
lib64/
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Entornos virtuales
venv/
env/
.venv/
.env/
ENV/

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
dist/
.vite/
*.local

# ── IDEs y editores ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Sistema operativo ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Docker ──────────────────────────────────────────────────
