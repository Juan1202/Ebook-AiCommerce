# ============================================================
# BookFlow AI Commerce — Plantilla de Variables de Entorno
# ============================================================
# Copia este archivo como .env y rellena los valores reales:
#   cp .env.example .env
# ============================================================

# ── Base de datos (PostgreSQL) ───────────────────────────────
POSTGRES_USER=tu_usuario_db
POSTGRES_PASSWORD=tu_contraseña_segura

DB_NAME_AUTH=auth_db
DB_NAME_INVENTORY=inventory_db
DB_NAME_CATALOG=catalog_db
DB_NAME_CONFIG=config_db

# ── Auth Service (JWT) ───────────────────────────────────────
# Genera un valor seguro con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Frontends ────────────────────────────────────────────────
VITE_BFF_URL=http://localhost:8009
