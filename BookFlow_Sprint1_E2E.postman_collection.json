		{
			"name": "01. Autenticación",
			"item": [
				{
					"name": "Registrar Administrador",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"email\": \"admin@bookflow.com\",\n    \"password\": \"admin123\",\n    \"role\": \"admin\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/auth/register",
							"host": [
								"{{base_url}}"
