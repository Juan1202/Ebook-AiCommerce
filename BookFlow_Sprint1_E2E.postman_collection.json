				{
					"name": "Login (Captura Token/Refresh)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"Tokens exist in response\", function () { ",
									"    pm.expect(jsonData.access_token).to.exist;",
									"    pm.expect(jsonData.refresh_token).to.exist;",
									"});",
									"if (jsonData.access_token) { pm.environment.set(\"jwt_token\", jsonData.access_token); }",
									"if (jsonData.refresh_token) { pm.environment.set(\"refresh_token\", jsonData.refresh_token); }"
								],
								"type": "text/javascript"
							}
