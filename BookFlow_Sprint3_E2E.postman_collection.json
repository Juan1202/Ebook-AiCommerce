{
  "info": {
    "_postman_id": "bookflow-e2e-sprint3",
    "name": "BookFlow E2E Sprint 3 — Cart & Orders",
    "description": "Complete end-to-end flow: Auth → Catalog → Cart → Orders",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1️⃣ AUTH — Get Mock Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var token = pm.response.json().access_token || pm.response.json().token;",
              "    pm.environment.set('TOKEN', token);",
              "    pm.test('✓ Token obtained', function() {",
              "        pm.expect(token).to.exist;",
              "    });",
              "} else {",
              "    pm.test('✗ Failed to get token', function() {",
              "        pm.expect(pm.response.code).to.equal(200);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8009/api/auth/mock-token",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "auth", "mock-token"]
        }
      }
    },
    {
      "name": "2️⃣ CATALOG — List Books",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var books = pm.response.json();",
              "    if (books.length > 0) {",
              "        pm.environment.set('BOOK_1_ID', books[0].id);",
              "        pm.environment.set('BOOK_1_TITLE', books[0].title);",
              "        pm.environment.set('BOOK_1_PRICE', books[0].price);",
              "        if (books.length > 1) {",
              "            pm.environment.set('BOOK_2_ID', books[1].id);",
              "            pm.environment.set('BOOK_2_TITLE', books[1].title);",
              "            pm.environment.set('BOOK_2_PRICE', books[1].price);",
              "        }",
              "    }",
              "    pm.test('✓ Books retrieved: ' + books.length, function() {",
              "        pm.expect(books.length).to.be.greaterThan(0);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": {
          "key": "Authorization",
          "value": "Bearer {{TOKEN}}"
        },
        "url": {
          "raw": "http://localhost:8009/api/catalog/books?published_only=true",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "catalog", "books"],
          "query": [
            {
              "key": "published_only",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "3️⃣ CATALOG — Get Book Detail (ID: {{BOOK_1_ID}})",
      "request": {
        "method": "GET",
        "header": {
          "key": "Authorization",
          "value": "Bearer {{TOKEN}}"
        },
        "url": {
          "raw": "http://localhost:8009/api/catalog/books/{{BOOK_1_ID}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "catalog", "books", "{{BOOK_1_ID}}"]
        }
      }
    },
    {
      "name": "4️⃣ PRICING — Get Price (ID: {{BOOK_1_ID}})",
      "request": {
        "method": "GET",
        "header": {
          "key": "Authorization",
          "value": "Bearer {{TOKEN}}"
        },
        "url": {
          "raw": "http://localhost:8009/api/pricing/{{BOOK_1_ID}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "pricing", "{{BOOK_1_ID}}"]
        }
      }
    },
    {
      "name": "5️⃣ INVENTORY — Check Availability",
      "request": {
        "method": "GET",
        "header": {
          "key": "Authorization",
          "value": "Bearer {{TOKEN}}"
        },
        "url": {
          "raw": "http://localhost:8009/api/inventory/availability/978-0743273565",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "inventory", "availability", "978-0743273565"]
        }
      }
    },
    {
      "name": "6️⃣ CART — Add Item 1 (Book {{BOOK_1_ID}})",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var cart = pm.response.json();",
              "    pm.environment.set('CART_ID', cart.id);",
              "    pm.environment.set('CART_TOTAL_ITEMS', cart.total_items);",
              "    pm.environment.set('CART_TOTAL_PRICE', cart.total_price);",
              "    pm.test('✓ Item added to cart', function() {",
              "        pm.expect(cart.items.length).to.equal(1);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": {
          "key": "Authorization",
          "value": "Bearer {{TOKEN}}"
        },
        "body": {
          "mode": "raw",
          "raw": "{\\n  \\\"book_id\\\": {{BOOK_1_ID}},\\n  \\\"title\\\": \\\"{{BOOK_1_TITLE}}\\\",\\n  \\\"author\\\": \\\"Test Author\\\",\\n  \\\"price\\\": {{BOOK_1_PRICE}},\\n  \\\"quantity\\\": 2,\\n  \\\"condition\\\": \\\"NUEVO\\\"\\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8009/api/cart/user-sprint3-test/items",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "cart", "user-sprint3-test", "items"]
        }
      }
    },
    {
      "name": "7️⃣ CART — Add Item 2 (Book {{BOOK_2_ID}})",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var cart = pm.response.json();",
              "    pm.environment.set('CART_TOTAL_ITEMS', cart.total_items);",
              "    pm.environment.set('CART_TOTAL_PRICE', cart.total_price);",
              "    pm.test('✓ Second item added', function() {",
              "        pm.expect(cart.items.length).to.be.greaterThanOrEqual(2);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": {
          "key": "Authorization",
          "value": "Bearer {{TOKEN}}"
        },
        "body": {
          "mode": "raw",
          "raw": "{\\n  \\\"book_id\\\": {{BOOK_2_ID}},\\n  \\\"title\\\": \\\"{{BOOK_2_TITLE}}\\\",\\n  \\\"author\\\": \\\"Test Author 2\\\",\\n  \\\"price\\\": {{BOOK_2_PRICE}},\\n  \\\"quantity\\\": 1,\\n  \\\"condition\\\": \\\"BUENO\\\"\\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8009/api/cart/user-sprint3-test/items",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "cart", "user-sprint3-test", "items"]
        }
      }
    },
    {
      "name": "8️⃣ CART — View Cart",
      "request": {
        "method": "GET",
        "header": {
          "key": "Authorization",
          "value": "Bearer {{TOKEN}}"
        },
        "url": {
          "raw": "http://localhost:8009/api/cart/user-sprint3-test",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "cart", "user-sprint3-test"]
        }
      }
    },
    {
      "name": "9️⃣ ORDER — Create Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var order = pm.response.json();",
              "    pm.environment.set('ORDER_ID', order.id);",
              "    pm.environment.set('ORDER_TOTAL', order.total_price);",
              "    pm.test('✓ Order created', function() {",
              "        pm.expect(order.status).to.equal('pending');",
              "        pm.expect(order.payment_status).to.equal('pending');",
              "    });",
              "} else {",
              "    pm.test('✗ Order creation failed: ' + pm.response.code, function() {",
              "        pm.expect(pm.response.code).to.equal(200);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": {
          "key": "Authorization",
          "value": "Bearer {{TOKEN}}",
          "type": "text"
        },
        "body": {
          "mode": "raw",
          "raw": "{\\n  \\\"user_id\\\": \\\"user-sprint3-test\\\",\\n  \\\"items\\\": [\\n    {\\n      \\\"book_id\\\": {{BOOK_1_ID}},\\n      \\\"title\\\": \\\"{{BOOK_1_TITLE}}\\\",\\n      \\\"author\\\": \\\"Test Author\\\",\\n      \\\"price\\\": {{BOOK_1_PRICE}},\\n      \\\"quantity\\\": 2,\\n      \\\"condition\\\": \\\"NUEVO\\\"\\n    },\\n    {\\n      \\\"book_id\\\": {{BOOK_2_ID}},\\n      \\\"title\\\": \\\"{{BOOK_2_TITLE}}\\\",\\n      \\\"author\\\": \\\"Test Author 2\\\",\\n      \\\"price\\\": {{BOOK_2_PRICE}},\\n      \\\"quantity\\\": 1,\\n      \\\"condition\\\": \\\"BUENO\\\"\\n    }\\n  ],\\n  \\\"shipping_address\\\": \\\"Calle Principal 123, Ciudad, País\\\",\\n  \\\"notes\\\": \\\"Entregar en horario de oficina\\\"\\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8009/api/order",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "order"]
        }
      }
    },
    {
      "name": "🔟 ORDER — Get Order Detail",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var order = pm.response.json();",
              "    pm.test('✓ Order retrieved', function() {",
              "        pm.expect(order.id).to.exist;",
              "        pm.expect(order.items.length).to.be.greaterThan(0);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": {
          "key": "Authorization",
          "value": "Bearer {{TOKEN}}"
        },
        "url": {
          "raw": "http://localhost:8009/api/order/{{ORDER_ID}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "order", "{{ORDER_ID}}"]
        }
      }
    },
    {
      "name": "1️⃣1️⃣ ORDER — Confirm Payment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var order = pm.response.json();",
              "    pm.test('✓ Payment confirmed', function() {",
              "        pm.expect(order.status).to.equal('confirmed');",
              "        pm.expect(order.payment_status).to.equal('completed');",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": {
          "key": "Authorization",
          "value": "Bearer {{TOKEN}}"
        },
        "url": {
          "raw": "http://localhost:8009/api/order/{{ORDER_ID}}/confirm",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "order", "{{ORDER_ID}}", "confirm"]
        }
      }
    },
    {
      "name": "1️⃣2️⃣ ORDER — List User Orders",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var result = pm.response.json();",
              "    pm.test('✓ User orders retrieved (count: ' + result.count + ')', function() {",
              "        pm.expect(result.orders.length).to.be.greaterThan(0);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": {
          "key": "Authorization",
          "value": "Bearer {{TOKEN}}"
        },
        "url": {
          "raw": "http://localhost:8009/api/order/user/user-sprint3-test",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["api", "order", "user", "user-sprint3-test"]
        }
      }
    },
    {
      "name": "🔄 HEALTH — Check All Services",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var health = pm.response.json();",
              "    pm.test('✓ Gateway health: ' + health.status, function() {",
              "        pm.expect(health.status).to.be.oneOf(['ok', 'degraded']);",
              "    });",
              "    pm.test('✓ Services status', function() {",
              "        pm.expect(health.services.auth.status).to.equal('ok');",
              "        pm.expect(health.services.catalog.status).to.equal('ok');",
              "        pm.expect(health.services.inventory.status).to.equal('ok');",
              "        pm.expect(health.services.cart.status).to.equal('ok');",
              "        pm.expect(health.services.order.status).to.equal('ok');",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8009/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8009",
          "path": ["health"]
        }
      }
    }
  ]
}
